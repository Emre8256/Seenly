# ==============================================================================
# 10Signal Backend Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# - For local development: copy this to .env (gitignored) and customize DEV_* values.
# - For production Docker deployment: provide these as container environment
#   variables via your deployment vault / orchestrator (e.g. docker-compose, k8s).
# - NEVER commit real credentials, passwords, or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Spring Profile & Environment Mode
# ------------------------------------------------------------------------------
# Options: 'dev' for local workstation, 'prod' for production deployment.
SPRING_PROFILES_ACTIVE=dev

# Deployment environment indicator (checked by ProfileSafetyValidator)
# Set to 'production' in production deployments to enforce safety checks.
DEPLOYMENT_ENVIRONMENT=development

# ------------------------------------------------------------------------------
# 2. Database Configuration
# ------------------------------------------------------------------------------
# Development PostgreSQL (used when SPRING_PROFILES_ACTIVE=dev)
DEV_DB_URL=jdbc:postgresql://localhost:5432/seenly_dev
DEV_DB_USERNAME=seenly_dev
DEV_DB_PASSWORD=seenly_dev_password

# Production PostgreSQL (mandatory when SPRING_PROFILES_ACTIVE=prod)
# Set to your internal PostgreSQL host / Docker container service name
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/tensignal_prod
SPRING_DATASOURCE_USERNAME=tensignal_app
SPRING_DATASOURCE_PASSWORD=your_strong_postgres_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 3. Security, CORS & Reverse Proxy (Production)
# ------------------------------------------------------------------------------
# CORS: Comma-separated allowlist of origins. Wildcards (*) and localhost are rejected in prod.
# Target production frontend domain: https://10signal.me
CORS_ALLOWED_ORIGINS=https://10signal.me

# Reverse Proxy Trust: Comma-separated CIDR ranges of direct upstream reverse proxies
# that terminate HTTPS (e.g., Nginx, Traefik, or Caddy).
# DO NOT use 0.0.0.0/0 or wide subnets. Use exact proxy IP (e.g. 127.0.0.1/32 or specific internal IP).
TRUSTED_PROXY_CIDRS=127.0.0.1/32

# HTTPS Enforcement: In production, non-secure HTTP requests are rejected with HTTP 426.
REQUIRE_HTTPS=true

# Management Port: Segregated port for Prometheus and Actuator metrics (default: 8081).
# Must NOT be published to the public internet.
MANAGEMENT_PORT=8081

# ------------------------------------------------------------------------------
# 4. Email Provider (Brevo / SMTP)
# ------------------------------------------------------------------------------
# Supported providers: 'brevo' (production default), 'smtp', 'disabled' (no-op)
EMAIL_PROVIDER=brevo
AUTH_MAIL_FROM=mail@10signal.me

# Brevo Configuration (required when EMAIL_PROVIDER=brevo)
# Domain: 10signal.me (Authenticated, DKIM/DMARC verified in Brevo)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=mail@10signal.me
BREVO_SENDER_NAME=10Signal
BREVO_REPLY_TO=10signal.me@gmail.com
BREVO_API_URL=https://api.brevo.com/v3/smtp/email

# SMTP Configuration (required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@10signal.me
SMTP_PASSWORD=your_smtp_password_here
SMTP_AUTH=true
SMTP_STARTTLS=true

# ------------------------------------------------------------------------------
# 5. Transactional Outbox & OTP Encryption
# ------------------------------------------------------------------------------
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_INTERVAL_MS=5000

# OTP Payload Encryption Key: Used by AES-256-GCM to encrypt OTP payloads in outbox.
# In production, this MUST be a high-entropy secret of at least 32 characters (256 bits).
# The insecure fallback key is rejected by ProductionSafetyConfiguration on startup.
EMAIL_OTP_PAYLOAD_SECRET=your_32_character_minimum_random_secret_here

# Email Inactivity and Lifecycle Reminders
EMAIL_INACTIVITY_DAYS=7
EMAIL_COOLDOWN_DAYS=30
EMAIL_LIFECYCLE_INTERVAL_MS=3600000

# ------------------------------------------------------------------------------
# 6. Payment Provider (Lemon Squeezy)
# ------------------------------------------------------------------------------
# Supported: 'disabled' (default), 'lemonsqueezy'
PAYMENT_PROVIDER=disabled
LEMON_SQUEEZY_API_KEY=your_lemon_squeezy_api_key_here
LEMON_SQUEEZY_WEBHOOK_SECRET=your_lemon_squeezy_webhook_secret_here

# Lemon Squeezy Checkout URLs for Current Launch Products (Version 2 Model):
# All URLs must be valid HTTPS endpoints for 10signal.lemonsqueezy.com
LEMON_SQUEEZY_PLUS_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_plus_variant_uuid
LEMON_SQUEEZY_CAPACITY_50_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_50_variant_uuid
LEMON_SQUEEZY_CAPACITY_150_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_150_variant_uuid
LEMON_SQUEEZY_CAPACITY_300_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_300_variant_uuid
