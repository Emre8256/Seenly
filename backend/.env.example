# ==============================================================================
# 10Signal Backend Environment Configuration Example
# Copy this file to .env or set these in your container / host environment.
# DO NOT commit real secrets or production passwords to source control.
# ==============================================================================

# Database
DEV_DB_URL=jdbc:postgresql://localhost:5432/seenly_dev
DEV_DB_USERNAME=seenly_dev
DEV_DB_PASSWORD=seenly_dev_password

# Email Provider Configuration
# Supported providers: 'brevo' (production default), 'disabled' (no network calls), 'smtp'
EMAIL_PROVIDER=brevo
AUTH_MAIL_FROM=mail@10signal.me

# Brevo Configuration (required when EMAIL_PROVIDER=brevo)
# Domain: 10signal.me (Authenticated, DKIM/DMARC verified)
# Subdomain: mail.10signal.me
BREVO_API_KEY=
BREVO_SENDER_EMAIL=mail@10signal.me
BREVO_SENDER_NAME=10Signal
BREVO_REPLY_TO=10signal.me@gmail.com

# SMTP Configuration (required only when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=postmaster@tensignal.app
SMTP_PASSWORD=your_smtp_password_here
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_CONNECTION_TIMEOUT_MS=5000
SMTP_READ_TIMEOUT_MS=5000
SMTP_WRITE_TIMEOUT_MS=5000

# Transactional Outbox & Security Settings
EMAIL_OUTBOX_BATCH_SIZE=20
EMAIL_OUTBOX_INTERVAL_MS=5000
EMAIL_OUTBOX_MAX_ATTEMPTS=5
EMAIL_OTP_PAYLOAD_SECRET=change-this-to-a-secure-256bit-secret-in-production

# Email Lifecycle & Reminders
EMAIL_INACTIVITY_DAYS=7
EMAIL_COOLDOWN_DAYS=30
EMAIL_LIFECYCLE_INTERVAL_MS=3600000

# Payment Provider
# Supported: 'disabled' (default), 'lemonsqueezy'
PAYMENT_PROVIDER=disabled
LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_SQUEEZY_PLUS_CHECKOUT_URL=https://seenly.lemonsqueezy.com/checkout/buy/c31e5d1b-a28d-46b1-99e1-6ec637c927da
LEMON_SQUEEZY_CAPACITY_100_CHECKOUT_URL=https://seenly.lemonsqueezy.com/checkout/buy/9e4aa985-a2dc-46da-a20a-246bc2d9e83c
LEMON_SQUEEZY_CAPACITY_250_CHECKOUT_URL=https://seenly.lemonsqueezy.com/checkout/buy/90f059cc-bd69-487a-9acf-f4f2f5d6c42b
LEMON_SQUEEZY_CAPACITY_500_CHECKOUT_URL=https://seenly.lemonsqueezy.com/checkout/buy/06107728-bcbb-42fa-b72e-3d7120db82ba
