# ==============================================================================
# 10Signal Frontend Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# - For local development: Vite proxy in vite.config.js automatically forwards
#   all `/api` requests to http://localhost:8080. Leave VITE_API_URL empty.
# - For production (e.g. Netlify): Set VITE_API_URL to the public API domain
#   (e.g., https://api.10signal.me) or configure Netlify redirect proxies.
# ==============================================================================

# Public Backend API Base URL
# Local development default: empty (uses Vite dev server proxy at /api)
# Production deployment: https://api.10signal.me
VITE_API_URL=
