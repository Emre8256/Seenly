# ==============================================================================
# 10Signal Production Environment Contract (.env.production.example)
#
# INSTRUCTIONS:
# 1. On your production host, copy this file to: .env
# 2. Fill in all real secrets from your password manager / vault.
# 3. DO NOT commit the filled .env file to Git!
# 4. Strict fail-fast validations are enforced on container startup.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime Profile & Environment
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
DEPLOYMENT_ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 2. PostgreSQL 16 Production Database
# Note: The database is completely internal; port 5432 is never exposed publicly.
# ------------------------------------------------------------------------------
POSTGRES_DB=tensignal_prod
POSTGRES_USER=tensignal_app
POSTGRES_PASSWORD=generate_a_very_strong_random_database_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# ------------------------------------------------------------------------------
# 3. Security, CORS & Reverse Proxy
# ------------------------------------------------------------------------------
# Target frontend domain on Netlify:
CORS_ALLOWED_ORIGINS=https://10signal.me

# Trusted Proxy CIDR: Must match the Caddy Docker bridge network subnet
# Default in docker-compose.prod.yml is 172.28.0.0/16
TRUSTED_PROXY_CIDRS=172.28.0.0/16

# Enforce HTTPS (HTTP 426 Upgrade Required if not HTTPS)
REQUIRE_HTTPS=true

# Let's Encrypt / ZeroSSL certificate expiry notifications:
ACME_EMAIL=admin@10signal.me

# ------------------------------------------------------------------------------
# 4. Brevo Transactional Email Service
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=brevo
AUTH_MAIL_FROM=mail@10signal.me
BREVO_API_KEY=your_production_brevo_v3_api_key_here
BREVO_SENDER_EMAIL=mail@10signal.me
BREVO_SENDER_NAME=10Signal
BREVO_REPLY_TO=10signal.me@gmail.com

# ------------------------------------------------------------------------------
# 5. Transactional Outbox & OTP Encryption
# Mandatory: High-entropy secret of at least 32 characters (256-bit).
# Used for AES-256-GCM encryption of OTP payloads in the database.
# ------------------------------------------------------------------------------
EMAIL_OTP_PAYLOAD_SECRET=generate_at_least_32_characters_random_hex_or_alphanumeric_here

# ------------------------------------------------------------------------------
# 6. Lemon Squeezy Payment & Webhooks
# Webhook Callback URL: https://api.10signal.me/api/v1/billing/webhooks/lemonsqueezy
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=lemonsqueezy
LEMON_SQUEEZY_API_KEY=your_live_lemon_squeezy_api_key_here
LEMON_SQUEEZY_WEBHOOK_SECRET=your_live_lemon_squeezy_webhook_signing_secret_here

# Lemon Squeezy Hosted Checkout URLs:
# Target store: 10signal.lemonsqueezy.com
LEMON_SQUEEZY_PLUS_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_plus_variant_uuid
LEMON_SQUEEZY_CAPACITY_50_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_50_variant_uuid
LEMON_SQUEEZY_CAPACITY_150_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_150_variant_uuid
LEMON_SQUEEZY_CAPACITY_300_CHECKOUT_URL=https://10signal.lemonsqueezy.com/checkout/buy/your_capacity_300_variant_uuid
